@using Shoppable.Enum
@using Shoppable.Models
@model ShopVM

@{
    ViewData["Title"] = "Home Page";
    // Layout = "_navlayout";
    <Title>Home page</Title>
}


<body class="animsition">

    <!-- Slider -->
    <div class="section-slide">
        <div class="wrap-slick1">
            <div class="slick1">
                <div class="item-slick1" style="background-image: url(/images/slide-01.jpg);">
                    @* photo 1 *@
                    <div class="container h-full">
                        <div class="flex-col-l-m h-full p-t-100 p-b-30 respon5">
                            <div class="layer-slick1 animated visible-false" data-appear="fadeInDown" data-delay="0">
                                <span class="ltext-101 cl2 respon2">
                                    Women Collection 2018
                                </span>
                            </div>

                            <div class="layer-slick1 animated visible-false" data-appear="fadeInUp" data-delay="800">
                                <h2 class="ltext-201 cl2 p-t-19 p-b-43 respon1">
                                    NEW SEASON
                                </h2>
                            </div>
                            <div class="layer-slick1 animated visible-false" data-appear="zoomIn" data-delay="1600">
                                <a asp-controller="Product" asp-action="ShopProducts" class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04">
                                    Shop Now
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="item-slick1" style="background-image: url(/images/slide-02.jpg);">
                    @* photo 2 *@
                    <div class="container h-full">
                        <div class="flex-col-l-m h-full p-t-100 p-b-30 respon5">
                            <div class="layer-slick1 animated visible-false" data-appear="rollIn" data-delay="0">
                                <span class="ltext-101 cl2 respon2">
                                    Men New-Season
                                </span>
                            </div>

                            <div class="layer-slick1 animated visible-false" data-appear="lightSpeedIn" data-delay="800">
                                <h2 class="ltext-201 cl2 p-t-19 p-b-43 respon1">
                                    Jackets & Coats
                                </h2>
                            </div>

                            <div class="layer-slick1 animated visible-false" data-appear="slideInUp" data-delay="1600">
                                <a asp-controller="Product" asp-action="ShopProducts" class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04">
                                    Shop Now
                                </a>
                            </div>
                        </div>
                    </div>
                </div>


                <div class="item-slick1" style="background-image: url(/images/slide-03.jpg);">
                    @* photo 3 *@
                    <div class="container h-full">
                        <div class="flex-col-l-m h-full p-t-100 p-b-30 respon5">
                            <div class="layer-slick1 animated visible-false" data-appear="rotateInDownLeft" data-delay="0">
                                <span class="ltext-101 cl2 respon2">
                                    Men Collection 2018
                                </span>
                            </div>

                            <div class="layer-slick1 animated visible-false" data-appear="rotateInUpRight" data-delay="800">
                                <h2 class="ltext-201 cl2 p-t-19 p-b-43 respon1">
                                    New arrivals
                                </h2>
                            </div>

                            <div class="layer-slick1 animated visible-false" data-appear="rotateIn" data-delay="1600">
                                <a asp-controller="Product" asp-action="ShopProducts" class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04">
                                    Shop Now
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- Banner -->
    <div class="sec-banner bg0 p-t-80 p-b-50">
        <div class="container">
            <div class="row">
                <div class="col-md-6 col-xl-4 p-b-30 m-lr-auto">
                    <!-- Block1 -->
                    <div class="block1 wrap-pic-w">
                        <img src="/images/banner-01.jpg" alt="IMG-BANNER">

                        <a asp-controller="Product" asp-action="ShopProducts" asp-route-category="@Category.Women" class="block1-txt ab-t-l s-full flex-col-l-sb p-lr-38 p-tb-34 trans-03 respon3">
                            <div class="block1-txt-child1 flex-col-l">
                                <span class="block1-name ltext-102 trans-04 p-b-8">
                                    Women
                                </span>

                                <span class="block1-info stext-102 trans-04">
                                    Spring 2018
                                </span>
                            </div>

                            <div class="block1-txt-child2 p-b-4 trans-05">
                                <div class="block1-link stext-101 cl0 trans-09">
                                    Shop Now
                                </div>
                            </div>
                        </a>
                    </div>
                </div>

                <div class="col-md-6 col-xl-4 p-b-30 m-lr-auto">
                    <!-- Block2 -->
                    <div class="block1 wrap-pic-w">
                        <img src="/images/banner-02.jpg" alt="IMG-BANNER">

                        <a asp-controller="Product" asp-action="ShopProducts" asp-route-category="@Category.Men" class="block1-txt ab-t-l s-full flex-col-l-sb p-lr-38 p-tb-34 trans-03 respon3">
                            <div class="block1-txt-child1 flex-col-l">
                                <span class="block1-name ltext-102 trans-04 p-b-8">
                                    Men
                                </span>

                                <span class="block1-info stext-102 trans-04">
                                    Spring 2018
                                </span>
                            </div>

                            <div class="block1-txt-child2 p-b-4 trans-05">
                                <div class="block1-link stext-101 cl0 trans-09">
                                    Shop Now
                                </div>
                            </div>
                        </a>
                    </div>
                </div>

                <div class="col-md-6 col-xl-4 p-b-30 m-lr-auto">
                    <!-- Block3 -->
                    <div class="block1 wrap-pic-w">
                        <img src="/images/banner-03.jpg" alt="IMG-BANNER">

                        <a asp-controller="Product" asp-action="ShopProducts" asp-route-category="@Category.Watches" class="block1-txt ab-t-l s-full flex-col-l-sb p-lr-38 p-tb-34 trans-03 respon3">
                            <div class="block1-txt-child1 flex-col-l">
                                <span class="block1-name ltext-102 trans-04 p-b-8">
                                    Accessories
                                </span>

                                <span class="block1-info stext-102 trans-04">
                                    New Trend
                                </span>
                            </div>

                            <div class="block1-txt-child2 p-b-4 trans-05">
                                <div class="block1-link stext-101 cl0 trans-09">
                                    Shop Now
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- New Arrivals -->
    <section class="sec-new-arrivals bg0 p-t-60 p-b-40" id="sec-new-arrivals">
        <div class="container">
            <!-- Section Header -->
            <div class="flex-w flex-c-m p-b-60">
                <div style="text-align: center; width: 100%;">
                    <span class="stext-107 cl6" style="text-transform: uppercase; letter-spacing: 3px; display: block; margin-bottom: 10px;">
                        Just Landed
                    </span>
                    <h2 class="ltext-103 cl2" style="position: relative; display: inline-block; padding-bottom: 15px;">
                        New Arrivals
                    </h2>
                    <div style="width: 60px; height: 3px; background: linear-gradient(90deg, #717fe0, #6c7ae0); margin: 0 auto; border-radius: 2px;"></div>
                    <p class="stext-108 cl6 p-t-18" style="max-width: 480px; margin: 0 auto;">
                        Discover the latest styles added to our collection
                    </p>
                </div>
            </div>

            <!-- New Arrivals Grid -->
            <div class="row" id="new-arrivals-grid">
                @if (Model.NewArrivals?.Count > 0)
                {
                    @foreach (var product in Model.NewArrivals)
                    {
                        <div class="col-sm-6 col-md-4 col-lg-3 p-b-35">
                            <div class="block2">
                                <div class="block2-pic hov-img0" style="position: relative;">
                                    <img src="@product.ImageUrl" alt="IMG-PRODUCT">

                                    <div style="position: absolute; top: 12px; right: 12px; background: linear-gradient(135deg, #717fe0, #6c7ae0); color: #fff; font-family: Poppins-Bold; font-size: 11px; text-transform: uppercase; padding: 4px 12px; border-radius: 12px; letter-spacing: 1px; box-shadow: 0 2px 8px rgba(108,122,224,0.4);">
                                        New
                                    </div>

                                    <a asp-controller="Product" asp-action="ProductDetails" asp-route-id="@product.Id" class="block2-btn flex-c-m stext-103 cl2 size-102 bg0 bor2 hov-btn1 p-lr-15 trans-04">
                                        View Details
                                    </a>
                                </div>

                                <div class="block2-txt flex-w flex-t p-t-14">
                                    <div class="block2-txt-child1 flex-col-l">
                                        <a asp-controller="Product" asp-action="productdetails" asp-route-id="@product.Id" class="stext-104 cl4 hov-cl1 trans-04 js-name-b2 p-b-6">
                                            @product.Name
                                        </a>
                                        <span class="stext-105 cl3">
                                            $@product.Price
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="stext-108 cl6" style="text-align: center; width: 100%;">No new arrivals yet. Check back soon!</p>
                }
            </div>

            <!-- View All New Arrivals Link -->
            <div class="flex-c-m flex-w w-full p-t-30 p-b-20">
                <a asp-controller="Product" asp-action="ShopProducts" class="flex-c-m stext-101 cl0 size-103 bg1 bor1 hov-btn2 p-lr-15 trans-04">
                    View All New Arrivals
                </a>
            </div>
        </div>
    </section>

    <!-- Best Bargain -->
    <section class="sec-best-bargain p-t-60 p-b-40" id="sec-best-bargain" style="background-color: #f7f8fa;">
        <div class="container">
            <!-- Section Header -->
            <div class="flex-w flex-c-m p-b-60">
                <div style="text-align: center; width: 100%;">
                    <span class="stext-107 cl6" style="text-transform: uppercase; letter-spacing: 3px; display: block; margin-bottom: 10px;">
                        Save More Today
                    </span>
                    <h2 class="ltext-103 cl2" style="position: relative; display: inline-block; padding-bottom: 15px;">
                        Best Bargains
                    </h2>
                    <div style="width: 60px; height: 3px; background: linear-gradient(90deg, #f9ba48, #f77f00); margin: 0 auto; border-radius: 2px;"></div>
                    <p class="stext-108 cl6 p-t-18" style="max-width: 480px; margin: 0 auto;">
                        Handpicked deals under $50 — great quality at unbeatable prices
                    </p>
                </div>
            </div>

            @{
                var bargainProducts = Model.Products?.Where(p => p.Price < 50).ToList() ?? new List<Product>();
            }

            <!-- Bargain Products Slider -->
            @if (bargainProducts.Count > 0)
            {
                <div class="wrap-slick2">
                    <div class="slick2">
                        @foreach (var product in bargainProducts)
                        {
                            <div class="item-slick2 p-l-15 p-r-15 p-t-15 p-b-15">
                                <div class="block2">
                                    <div class="block2-pic hov-img0" style="position: relative;">
                                        <img src="@product.ImageUrl" alt="IMG-PRODUCT">

                                        <div style="position: absolute; top: 12px; right: 12px; background: linear-gradient(135deg, #f9ba48, #f77f00); color: #fff; font-family: Poppins-Bold; font-size: 11px; text-transform: uppercase; padding: 4px 12px; border-radius: 12px; letter-spacing: 1px; box-shadow: 0 2px 8px rgba(247,127,0,0.4);">
                                            Under $50
                                        </div>

                                        <a asp-controller="Product" asp-action="ProductDetails" asp-route-id="@product.Id" class="block2-btn flex-c-m stext-103 cl2 size-102 bg0 bor2 hov-btn1 p-lr-15 trans-04">
                                            View Details
                                        </a>
                                    </div>

                                    <div class="block2-txt flex-w flex-t p-t-14">
                                        <div class="block2-txt-child1 flex-col-l">
                                            <a asp-controller="Product" asp-action="productdetails" asp-route-id="@product.Id" class="stext-104 cl4 hov-cl1 trans-04 js-name-b2 p-b-6">
                                                @product.Name
                                            </a>
                                            <div style="display: flex; align-items: center; gap: 8px;">
                                                <span class="stext-105" style="color: #f9ba48; font-weight: bold;">
                                                    $@product.Price
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <p class="stext-108 cl6" style="text-align: center;">No bargains under $50 right now. Check back soon!</p>
            }

            <!-- View All Bargains Link -->
            <div class="flex-c-m flex-w w-full p-t-30 p-b-20">
                <a asp-controller="Product" asp-action="ShopProducts" asp-route-Maxprice="49" class="flex-c-m stext-101 cl0 size-103 bg1 bor1 hov-btn2 p-lr-15 trans-04">
                    Shop All Bargains
                </a>
            </div>
        </div>
    </section>

    <!-- Product -->
    <section class="bg0 p-t-60 p-b-140">
        <div class="container">
            <!-- Section Header -->
            <div class="flex-w flex-c-m p-b-60">
                <div style="text-align: center; width: 100%;">
                    <h2 class="ltext-103 cl2" style="position: relative; display: inline-block; padding-bottom: 15px;">
                        Explore Our Products
                    </h2>
                    <div style="width: 60px; height: 3px; background: linear-gradient(90deg, #717fe0, #6c7ae0); margin: 0 auto; border-radius: 2px;"></div>
                </div>
            </div>

            <!-- Filter & search -->
            <div class="flex-w flex-sb-m p-b-52">

                <!-- categories -->
                <form method="get" asp-action="ShopProducts" asp-controller="Product">
                    <div class="flex-w flex-l-m filter-tope-group m-tb-10">
                        @foreach (Category category in Enum.GetValues<Category>())
                        {
                            <button type="submit"
                                    name="category"
                                    value="@((int)category)"
                                    class="stext-106 cl6 hov1 bor3 trans-04 m-r-32 m-tb-5 @(Model.category == category ? "how-active1" : "")">
                                @(category == Category.All ? "All Products" : category.ToString())
                            </button>
                        }
                    </div>
                </form>

                <!-- filter & search  partial view -->
                <partial name="_ProductFilterPV" model='new ProductFilterPV_VM{
                    Minprice = Model.Minprice,
                    Maxprice = Model.Maxprice,
                    Color    = Model.Color,
                    Size     = Model.Size,
                    Search   = Model.Search
                }' />
            </div>

            <!-- products list -->
            <div class="row isotope-grid">
                @foreach (var product in Model.Products)
                {
                    @if (Model.category == Category.All || product.category == Model.category)
                    {
                        <div class="col-sm-6 col-md-4 col-lg-3 p-b-35 isotope-item ">
                            <div class="block2">
                                <div class="block2-pic hov-img0">
                                    <img src="@product.ImageUrl" alt="IMG-PRODUCT">
                                    <a asp-controller="Product" asp-action="ProductDetails" asp-route-id="@product.Id" class="block2-btn flex-c-m stext-103 cl2 size-102 bg0 bor2 hov-btn1 p-lr-15 trans-04">
                                        View Details
                                    </a>
                                </div>

                                <div class="block2-txt flex-w flex-t p-t-14">
                                    <div class="block2-txt-child1 flex-col-l ">
                                        <a asp-controller="Product" asp-action="productdetails" asp-route-id="@product.Id" class="stext-104 cl4 hov-cl1 trans-04 js-name-b2 p-b-6">
                                            @product.Name
                                        </a>

                                        <span class="stext-105 cl3">
                                            $@product.Price
                                        </span>
                                    </div>


                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
            <!-- Shop all btn -->
            <div class="flex-c-m flex-w w-full p-t-45">
                <a asp-controller="Product" asp-action="ShopProducts" class="flex-c-m stext-101 cl5 size-103 bg2 bor1 hov-btn1 p-lr-15 trans-04">
                    Shop All Products
                </a>
            </div>

        </div>
    </section>


    <!-- Footer -->
    <footer class="bg3 p-t-75 p-b-32">
       <partial name="_FooterPV"/>
    </footer>


    <!-- Back to top -->
    <div class="btn-back-to-top" id="myBtn">
        <span class="symbol-btn-back-to-top">
            <i class="zmdi zmdi-chevron-up"></i>
        </span>
    </div>

    <!--===============================================================================================-->
    <script src="/vendor/jquery/jquery-3.2.1.min.js"></script>
    <!--===============================================================================================-->
    <script src="/vendor/animsition/js/animsition.min.js"></script>
    <!--===============================================================================================-->
    <script src="/vendor/bootstrap/js/popper.js"></script>
    <script src="/vendor/bootstrap/js/bootstrap.min.js"></script>
    <!--===============================================================================================-->
    <script src="/vendor/select2/select2.min.js"></script>
    <script>
        $(".js-select2").each(function(){
            $(this).select2({
                minimumResultsForSearch: 20,
                dropdownParent: $(this).next('.dropDownSelect2')
            });
        })
    </script>
    <!--===============================================================================================-->
    <script src="/vendor/daterangepicker/moment.min.js"></script>
    <script src="/vendor/daterangepicker/daterangepicker.js"></script>
    <!--===============================================================================================-->
    <script src="/vendor/slick/slick.min.js"></script>
    <script src="js/slick-custom.js"></script>
    <!--===============================================================================================-->
    <script src="/vendor/parallax100/parallax100.js"></script>
    <script>
        $('.parallax100').parallax100();
    </script>
    <!--===============================================================================================-->
    <script src="/vendor/MagnificPopup/jquery.magnific-popup.min.js"></script>
    <script>
        $('.gallery-lb').each(function() { // the containers for all your galleries
            $(this).magnificPopup({
                delegate: 'a', // the selector for gallery item
                type: 'image',
                gallery: {
                    enabled:true
                },
                mainClass: 'mfp-fade'
            });
        });
    </script>
    <!--===============================================================================================-->
    <script src="/vendor/isotope/isotope.pkgd.min.js"></script>
    <!--===============================================================================================-->
    <script src="/vendor/sweetalert/sweetalert.min.js"></script>
    @if (TempData["SuccessfulOrder"] != null)
    {
        <script>
            swal("Success", "@TempData["SuccessfulOrder"]", "success");
        </script>
    }
    <script>
        $('.js-addwish-b2').on('click', function(e){
            e.preventDefault();
        });

        $('.js-addwish-b2').each(function(){
            var nameProduct = $(this).parent().parent().find('.js-name-b2').html();
            $(this).on('click', function(){
                swal(nameProduct, "is added to wishlist !", "success");

                $(this).addClass('js-addedwish-b2');
                $(this).off('click');
            });
        });

        $('.js-addwish-detail').each(function(){
            var nameProduct = $(this).parent().parent().parent().find('.js-name-detail').html();

            $(this).on('click', function(){
                swal(nameProduct, "is added to wishlist !", "success");

                $(this).addClass('js-addedwish-detail');
                $(this).off('click');
            });
        });

        /*---------------------------------------------*/

        $('.js-addcart-detail').each(function(){
            var nameProduct = $(this).parent().parent().parent().parent().find('.js-name-detail').html();
            $(this).on('click', function(){
                swal(nameProduct, "is added to cart !", "success");
            });
        });

    </script>
    <!--===============================================================================================-->
    <script src="/vendor/perfect-scrollbar/perfect-scrollbar.min.js"></script>
    <script>
        $('.js-pscroll').each(function(){
            $(this).css('position','relative');
            $(this).css('overflow','hidden');
            var ps = new PerfectScrollbar(this, {
                wheelSpeed: 1,
                scrollingThreshold: 1000,
                wheelPropagation: false,
            });

            $(window).on('resize', function(){
                ps.update();
            })
        });
    </script>
    <!--===============================================================================================-->
    <script src="/js/main.js"></script>

</body>
@* </html> *@
